with "config/representation_examples_config.gpr";
project Representation_Examples is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Representation_Examples_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("quickstart.adb");

   package Compiler is
      for Default_Switches ("Ada") use Representation_Examples_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatyM120", "-gnatX");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Representation_Examples;
