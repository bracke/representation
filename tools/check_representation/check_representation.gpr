with "config/check_representation_config.gpr";
project Check_Representation is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Check_Representation_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("check_representation.adb");

   package Compiler is
      for Default_Switches ("Ada") use Check_Representation_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatyM120", "-gnatX");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Check_Representation;
